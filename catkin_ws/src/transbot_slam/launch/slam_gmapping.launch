<launch>
    <!-- Static TF: base_link to laser (RPLidar mounted 0.15m above base) -->
    <node pkg="tf" type="static_transform_publisher" name="lidar_tf"
          args="0 0 0.15 0 0 0 base_link laser 100" />

    <!-- GMapping SLAM node -->
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
        <!-- Frame parameters -->
        <param name="base_frame" value="base_link"/>
        <param name="odom_frame" value="odom"/>
        <param name="map_frame" value="map"/>

        <!-- Laser parameters (RPLidar A1/A2 typical range) -->
        <param name="maxUrange" value="6.0"/>
        <param name="maxRange" value="8.0"/>

        <!-- Map update -->
        <param name="map_update_interval" value="2.0"/>

        <!-- Particle filter -->
        <param name="particles" value="30"/>
        <param name="linearUpdate" value="0.2"/>
        <param name="angularUpdate" value="0.2"/>
        <param name="temporalUpdate" value="3.0"/>

        <!-- Map resolution -->
        <param name="delta" value="0.05"/>
        <param name="xmin" value="-15.0"/>
        <param name="ymin" value="-15.0"/>
        <param name="xmax" value="15.0"/>
        <param name="ymax" value="15.0"/>

        <!-- Processing (keep low for Jetson) -->
        <param name="iterations" value="5"/>
        <param name="lsigma" value="0.075"/>
        <param name="ogain" value="3.0"/>
        <param name="minimumScore" value="50"/>
    </node>
</launch>
